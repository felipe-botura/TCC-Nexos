@model IEnumerable<Nexos.Models.CampanhaMesa>

@{
    ViewData["Title"] = "Mesas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-container {
        background: linear-gradient(135deg, #1a0b2e 0%, #2d1b4e 100%);
        min-height: 100vh;
        padding: 60px 0;
    }

    .page-header {
        text-align: center;
        margin-bottom: 50px;
        color: white;
    }

    .page-header h1 {
        font-weight: 700;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #a855f7, #ec4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .page-header p {
        color: rgba(255, 255, 255, 0.7);
    }

    .btn-add-new {
        background: linear-gradient(135deg, #a855f7, #ec4899);
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(168, 85, 247, 0.4);
        text-decoration: none;
        display: inline-block;
        margin-bottom: 40px;
    }

    .btn-add-new:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(168, 85, 247, 0.6);
        color: white;
    }

    .btn-add-new i {
        margin-right: 10px;
    }

    .campaigns-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 30px;
        padding: 0 20px;
    }

    .campaign-card-admin {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 25px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .campaign-card-admin:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(168, 85, 247, 0.3);
        border-color: rgba(168, 85, 247, 0.5);
    }

    .card-header-admin {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .card-title-admin {
        font-weight: 700;
        color: white;
        margin: 0;
        flex: 1;
    }

    .status-badge {
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-ativa {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
        border: 1px solid #22c55e;
    }

    .status-breve {
        background: rgba(251, 191, 36, 0.2);
        color: #fbbf24;
        border: 1px solid #fbbf24;
    }

    .card-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .info-item {
        background: rgba(255, 255, 255, 0.03);
        padding: 12px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .info-label {
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .info-value {
        color: white;
        font-weight: 600;
    }

    .card-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-action {
        flex: 1;
        min-width: 100px;
        padding: 10px 20px;
        border-radius: 10px;
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
        display: inline-block;
    }

    .btn-edit {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
    }

    .btn-edit:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        transform: translateY(-2px);
        color: white;
    }

    .btn-details {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        color: white;
    }

    .btn-details:hover {
        background: linear-gradient(135deg, #7c3aed, #6d28d9);
        transform: translateY(-2px);
        color: white;
    }

    .btn-delete {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        flex: 1 1 100%;
    }

    .btn-delete:hover {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        transform: translateY(-2px);
        color: white;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: rgba(255, 255, 255, 0.6);
    }

    .empty-state i {
        margin-bottom: 20px;
        opacity: 0.3;
    }

    .empty-state h3 {
        margin-bottom: 10px;
        color: white;
    }

    @* @Media (max-width: 768px) {
        .campaigns-grid {
            grid-template-columns: 1fr;
        }

        .page-header h1 {
            font-size: 2rem;
        }

        .card-info-grid {
            grid-template-columns: 1fr;
        } *@
    }
</style>

<div class="admin-container">
    <div class="container">
        <div class="page-header">
            <h1><i class="fas fa-dice-d20"></i> Gerenciar Mesas</h1>
            <p>Administre todas as campanhas e mesas de RPG da plataforma</p>
        </div>

        <div class="text-center">
            <a asp-action="Create" class="btn-add-new">
                <i class="fas fa-plus-circle"></i> Adicionar Nova Mesa
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="campaigns-grid">
                @foreach (var item in Model)
                {
                    <div class="campaign-card-admin">
                        <div class="card-header-admin">
                            <h3 class="card-title-admin">@item.Titulo_Campanha</h3>
                            <span class="status-badge @(item.Status_Campanha == "Ativa" ? "status-ativa" : "status-breve")">
                                @item.Status_Campanha
                            </span>
                        </div>

                        <div class="card-info-grid">
                            <div class="info-item">
                                <div class="info-label">
                                    <i class="fas fa-user-tie"></i> Mestre
                                </div>
                                <div class="info-value">
                                    @(item.Mestre != null ? item.Mestre.Nome : "N/A")
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-label">
                                    <i class="fas fa-gamepad"></i> Sistema
                                </div>
                                <div class="info-value">
                                    @(item.Sistema != null ? item.Sistema.Nome_Sistema : "N/A")
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-label">
                                    <i class="fas fa-book"></i> Gênero
                                </div>
                                <div class="info-value">
                                    @(item.Genero != null ? item.Genero.Nome_Genero : "N/A")
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-label">
                                    <i class="fas fa-users"></i> Vagas
                                </div>
                                <div class="info-value">
                                    @item.Vagas_Disponiveis / @item.Numero_Jogadores
                                </div>
                            </div>
                        </div>

                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@item.ID_Campanha" class="btn-action btn-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.ID_Campanha" class="btn-action btn-details">
                                <i class="fas fa-eye"></i> Detalhes
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.ID_Campanha" class="btn-action btn-delete">
                                <i class="fas fa-trash"></i> Excluir
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h3>Nenhuma mesa cadastrada</h3>
                <p>Comece adicionando sua primeira mesa de RPG!</p>
            </div>
        }
    </div>
</div>