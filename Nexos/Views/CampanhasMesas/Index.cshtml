@model IEnumerable<Nexos.Models.CampanhaMesa>

@{
    ViewData["Title"] = "Mesas";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container pt-50 pb-50">
    <div class="row">
        <div class="col-lg-12" style="padding-top: 30px;">
            <h1 class="section-title mb-40">Gerenciar Mesas</h1>
            <p class="mb-30">
                <a asp-action="Create" class="btn hero-btn">Adicionar Nova Mesa</a>
            </p>
            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Titulo_Campanha)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Mestre)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Sistema)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Genero)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Status_Campanha)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Vagas_Disponiveis)
                            </th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Titulo_Campanha)
                                </td>
                                <td>
                                    @(item.Mestre != null ? item.Mestre.UserName : "N/A")
                                </td>
                                <td>
                                    @(item.Sistema != null ? item.Sistema.Nome_Sistema : "N/A")
                                </td>
                                <td>
                                    @(item.Genero != null ? item.Genero.Nome_Genero : "N/A")
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status_Campanha)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Vagas_Disponiveis)
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.ID_Campanha"
                                        class="btn btn-sm btn-primary">Editar</a> |
                                    <a asp-action="Details" asp-route-id="@item.ID_Campanha"
                                        class="btn btn-sm btn-info">Detalhes</a> |
                                    <a asp-action="Delete" asp-route-id="@item.ID_Campanha"
                                        class="btn btn-sm btn-danger">Excluir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
