@model Nexos.Models.CampanhaMesa

@{
    ViewData["Title"] = "Criar Mesa";
}

@section Styles {
    <style>
        .create-campaign-container {
            background: linear-gradient(135deg, #1a0b2e 0%, #2d1b4e 100%);
            min-height: 100vh;
            padding: 80px 0 60px;
        }

        .create-header {
            text-align: center;
            color: white;
            margin-bottom: 50px;
        }

        .create-header h1 {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 15px;
        }

        .create-header p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.1rem;
        }

        .form-container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 40px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .section-title {
            color: white;
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(168, 85, 247, 0.3);
        }

        .form-label {
            color: white;
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
        }

        .form-control,
        .form-select {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            color: white;
            padding: 12px 15px;
            transition: all 0.3s ease;
        }

        .form-control:focus,
        .form-select:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: #a855f7;
            box-shadow: 0 0 0 0.2rem rgba(168, 85, 247, 0.25);
            color: white;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .form-select option {
            background: #2d1b4e;
            color: white;
        }

        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        .button-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 40px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border: none;
            color: white;
            padding: 15px 50px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(168, 85, 247, 0.4);
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(168, 85, 247, 0.6);
        }

        .btn-cancel {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 15px 50px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.5);
            color: white;
        }

        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .tag-button {
            background: rgba(168, 85, 247, 0.2);
            border: 2px solid rgba(168, 85, 247, 0.5);
            color: white;
            padding: 8px 20px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tag-button:hover,
        .tag-button.active {
            background: rgba(168, 85, 247, 0.4);
            border-color: #a855f7;
            transform: translateY(-2px);
        }

        .vagas-control {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .vagas-button {
            background: rgba(168, 85, 247, 0.3);
            border: none;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .vagas-button:hover {
            background: rgba(168, 85, 247, 0.5);
            transform: scale(1.1);
        }

        .vagas-display {
            font-size: 2rem;
            font-weight: 700;
            color: white;
            min-width: 60px;
            text-align: center;
        }

        .text-danger {
            color: #ff6b9d !important;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .alert-danger {
            background: rgba(255, 107, 157, 0.2);
            border: 1px solid rgba(255, 107, 157, 0.5);
            color: #ff6b9d;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 30px;
        }

            .form-container {
                padding: 25px;
            }

            .button-group {
                flex-direction: column;
            }

            .btn-submit,
            .btn-cancel {
                width: 100%;
            }
        }
    </style>
}

<div class="create-campaign-container">
    <div class="container">
        <div class="create-header">
            <h1><i class="fas fa-dice-d20"></i> Crie a sua Mesa</h1>
            <p>Junte um grupo, e comece a mestrar sua campanha!</p>
        </div>

        <div class="form-container">
            <form asp-action="Create" asp-controller="CampanhasMesas" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Detalhes da Campanha -->
                <h3 class="section-title">Detalhes da Campanha</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Os detalhes da campanha são importantes, tente não se esquecer de nada
                </p>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <label asp-for="Titulo_Campanha" class="form-label">Título</label>
                        <input asp-for="Titulo_Campanha" class="form-control" 
                               placeholder="Título da aventura" />
                        <span asp-validation-for="Titulo_Campanha" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Dias e Horários</label>
                        <input asp-for="Dias_Horarios" class="form-control" 
                               placeholder="Duas e horários em que as sessões vão acontecer" />
                        <span asp-validation-for="Dias_Horarios" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ID_Sistema" class="form-label">Sistema</label>
                        <select asp-for="ID_Sistema" class="form-select" asp-items="ViewBag.ID_Sistema">
                            <option value="">Selecione o sistema que você usará</option>
                        </select>
                        <span asp-validation-for="ID_Sistema" class="text-danger"></span>
                    </div>
                </div>

                <!-- Status e Modalidade -->
                <h3 class="section-title mt-5">Status</h3>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Selecione o status atual da campanha</label>
                        <div class="tags-container">
                            <input type="radio" name="Status_Campanha" value="Ativa" id="statusAtiva" style="display: none;" />
                            <label for="statusAtiva" class="tag-button" onclick="this.previousElementSibling.checked = true">
                                Ativa
                            </label>
                            
                            <input type="radio" name="Status_Campanha" value="Em breve" id="statusBreve" style="display: none;" />
                            <label for="statusBreve" class="tag-button" onclick="this.previousElementSibling.checked = true">
                                Em breve
                            </label>
                        </div>
                        <span asp-validation-for="Status_Campanha" class="text-danger"></span>
                    </div>
                </div>

                <!-- Modalidade -->
                <h3 class="section-title mt-5">Modalidade</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Escolha a modalidade que melhor se encaixa para você e para os futuros players da mesa
                </p>
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="tags-container">
                            <input type="radio" name="Modalidade" value="Presencial" id="modalPresencial" style="display: none;" />
                            <label for="modalPresencial" class="tag-button" onclick="this.previousElementSibling.checked = true">
                                Presencial
                            </label>
                            
                            <input type="radio" name="Modalidade" value="Online" id="modalOnline" style="display: none;" />
                            <label for="modalOnline" class="tag-button" onclick="this.previousElementSibling.checked = true">
                                Online
                            </label>
                        </div>
                        <span asp-validation-for="Modalidade" class="text-danger"></span>
                    </div>
                </div>

                <!-- Plataforma -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label class="form-label">Plataforma</label>
                        <input asp-for="Plataformas" class="form-control" 
                               placeholder="Plataformas que você usará, como discord, owlbear, roll20..." />
                        <span asp-validation-for="Plataformas" class="text-danger"></span>
                    </div>
                </div>

                <!-- Premissa da campanha -->
                <h3 class="section-title mt-5">Premissa da campanha</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Um texto que fale tudo que você precisa saber inicialmente sobre a campanha que será inicialmente para
                    os futuros players esperem para campanha
                </p>
                <div class="row mb-4">
                    <div class="col-md-12">
                        <textarea asp-for="Premissa_Campanha" class="form-control" 
                                  placeholder="Fale sobre o que é a campanha, seu cenário, história, para atrair mais futuros jogadores!"></textarea>
                        <span asp-validation-for="Premissa_Campanha" class="text-danger"></span>
                    </div>
                </div>

                <!-- O que esperar -->
                <h3 class="section-title mt-5">O que esperar</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Fale suas expectativas enquanto mestre, isso pode alistar a atenção dos futuros players da campanha
                </p>
                <div class="row mb-4">
                    <div class="col-md-12">
                        <textarea asp-for="O_Que_Esperar" class="form-control" 
                                  placeholder="Quais suas expectativas?"></textarea>
                        <span asp-validation-for="O_Que_Esperar" class="text-danger"></span>
                    </div>
                </div>

                <!-- Requisitos -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label class="form-label">Requisitos</label>
                        <input asp-for="Requisitos" class="form-control" 
                               placeholder="Requisitos específicos como microfone, câmera, livros do sistema, etc..." />
                        <span asp-validation-for="Requisitos" class="text-danger"></span>
                    </div>
                </div>

                <!-- Categoria -->
                <h3 class="section-title mt-5">Categoria</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Selecione o sistema que você usará
                </p>
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label asp-for="ID_Genero" class="form-label">Gênero</label>
                        <select asp-for="ID_Genero" class="form-select" asp-items="ViewBag.ID_Genero">
                            <option value="">Selecione um gênero</option>
                        </select>
                        <span asp-validation-for="ID_Genero" class="text-danger"></span>
                    </div>
                </div>

                <!-- Vagas disponíveis -->
                <h3 class="section-title mt-5">Vagas disponíveis</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Selecione quantas tem disponível para a sua campanha
                </p>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="vagas-control">
                            <button type="button" class="vagas-button" onclick="decrementVagas()">
                                <i class="fas fa-minus"></i>
                            </button>
                            <div class="vagas-display" id="vagasDisplay">0</div>
                            <button type="button" class="vagas-button" onclick="incrementVagas()">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <input type="hidden" asp-for="Vagas_Disponiveis" id="vagasInput" value="0" />
                        <input type="hidden" asp-for="Numero_Jogadores" id="numJogadoresInput" value="0" />
                        <span asp-validation-for="Vagas_Disponiveis" class="text-danger"></span>
                    </div>
                </div>

                <!-- Faixa Etária -->
                <h3 class="section-title mt-5">Faixa Etária</h3>
                <div class="row mb-4">
                    <div class="col-12">
                        <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 20px;">
                            Em caso de temas sensíveis, você deve escolher a faixa etária
                        </p>
                        <div class="tags-container">
                            <input type="radio" name="Faixa_Etaria" value="+12" id="faixa12" style="display: none;" />
                            <label for="faixa12" class="tag-button" onclick="this.previousElementSibling.checked = true">+12</label>
                            
                            <input type="radio" name="Faixa_Etaria" value="+14" id="faixa14" style="display: none;" />
                            <label for="faixa14" class="tag-button" onclick="this.previousElementSibling.checked = true">+14</label>
                            
                            <input type="radio" name="Faixa_Etaria" value="+16" id="faixa16" style="display: none;" />
                            <label for="faixa16" class="tag-button" onclick="this.previousElementSibling.checked = true">+16</label>
                            
                            <input type="radio" name="Faixa_Etaria" value="+18" id="faixa18" style="display: none;" />
                            <label for="faixa18" class="tag-button" onclick="this.previousElementSibling.checked = true">+18</label>
                            
                            <input type="radio" name="Faixa_Etaria" value="Live" id="faixaLive" style="display: none;" />
                            <label for="faixaLive" class="tag-button" onclick="this.previousElementSibling.checked = true">Live</label>
                        </div>
                        <span asp-validation-for="Faixa_Etaria" class="text-danger"></span>
                    </div>
                </div>

                <!-- Hidden fields (ID_Mestre será definido no controller) -->
                <input type="hidden" asp-for="Imagem_Capa" value="/img/campaigns/placeholder1.png" />

                <!-- Botões -->
                <div class="button-group">
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save"></i> Criar Mesa
                    </button>
                    <a href="@Url.Action("Mesas", "Home")" class="btn-cancel">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        let vagasCount = 0;

        function incrementVagas() {
            vagasCount++;
            updateVagasDisplay();
        }

        function decrementVagas() {
            if (vagasCount > 0) {
                vagasCount--;
                updateVagasDisplay();
            }
        }

        function updateVagasDisplay() {
            document.getElementById('vagasDisplay').textContent = vagasCount;
            document.getElementById('vagasInput').value = vagasCount;
            document.getElementById('numJogadoresInput').value = vagasCount;
        }

        // Adicionar classe active aos botões de tag quando clicados
        document.addEventListener('DOMContentLoaded', function() {
            const tagButtons = document.querySelectorAll('.tag-button');
            
            tagButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Remove active de todos os botões do mesmo grupo
                    const radioInput = this.previousElementSibling;
                    const radioName = radioInput.name;
                    
                    document.querySelectorAll(`input[name="${radioName}"]`).forEach(input => {
                        input.nextElementSibling.classList.remove('active');
                    });
                    
                    // Adiciona active ao botão clicado
                    this.classList.add('active');
                });
            });
        });
    </script>
}