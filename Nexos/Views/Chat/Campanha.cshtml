@model Nexos.ViewModels.ChatCampanhaViewModel
@{
    ViewData["Title"] = $"Chat da Campanha: {Model.Campanha.Titulo_Campanha}";
}

<section class="section-padding">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h2 style="padding-top: 15px;" class="text-center white-color">Chat da Campanha: @Model.Campanha.Titulo_Campanha</h2>
                <p class="text-center white-color">Você é: @(Model.IsMestre ? "Mestre" : "Jogador")</p>
                <hr style="border-color: #f067ff;" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div id="chat-container" class="card" style="height: 500px; overflow-y: scroll; padding: 10px; background-color: #2D0A31; border: 1px solid #f067ff;">
                    @foreach (var mensagem in Model.Mensagens)
                    {
                        var isMine = mensagem.UserId == Model.UserId;
                        var alignClass = isMine ? "text-end" : "text-start"; // Usando text-end para Bootstrap 5
                        var bubbleClass = isMine ? "theme-bg text-white" : "white-bg black-color";
                        var role = mensagem.TipoUsuario == 1 ? "Mestre" : "Jogador";

                        <div class="d-flex @(isMine ? "justify-content-end" : "justify-content-start") mb-2">
                            @if (!isMine)
                            {
                                <img src="@(string.IsNullOrEmpty(mensagem.User.Foto) ? "/img/default-avatar.png" : mensagem.User.Foto)" alt="Avatar" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
                            }
                            <div class="message-content @alignClass">
                                <small class="text-muted" style="color: #ccc !important;">@role - @mensagem.User.Nome (@mensagem.DataHora.ToString("dd/MM HH:mm"))</small>
                                <div class="p-2 rounded @bubbleClass d-inline-block" style="max-width: 70%;">
                                    @mensagem.Texto
                                </div>
                            </div>
                            @if (isMine)
                            {
                                <img src="@(string.IsNullOrEmpty(mensagem.User.Foto) ? "/img/default-avatar.png" : mensagem.User.Foto)" alt="Avatar" class="rounded-circle ms-2" style="width: 40px; height: 40px; object-fit: cover;">
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <div class="input-group chat-input-group">
                    <input type="text" id="messageInput" class="form-control" placeholder="Digite sua mensagem..." />
                    <button class="btn chat-send-btn" id="sendButton" type="button">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        const campanhaId = @Model.Campanha.ID_Campanha;
        const userId = "@Model.UserId";
        const tipoUsuario = @(Model.IsMestre ? 1 : 0);

        // 1. Receber Mensagem
        connection.on("ReceiveMessage", function (user, message, time, tipo, userName, userPhotoUrl) {
            const isMine = user === userId;
            const alignClass = isMine ? "text-end" : "text-start";
            const bubbleClass = isMine ? "theme-bg text-white" : "white-bg black-color";
            const role = tipo === 1 ? "Mestre" : "Jogador";
            const senderName = userName;
            const userPhotoUrl = userPhotoUrl;

            const messageHtml = `
                <div class="d-flex ${isMine ? "justify-content-end" : "justify-content-start"} mb-2">
                    ${!isMine ? `<img src="${userPhotoUrl}" alt="Avatar" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">` : ''}
                    <div class="message-content ${alignClass}">
                        <small class="text-muted" style="color: #ccc !important;">${role} - ${senderName} (${time})</small>
                        <div class="p-2 rounded ${bubbleClass} d-inline-block" style="max-width: 70%;">
                            ${message}
                        </div>
                    </div>
                    ${isMine ? `<img src="${userPhotoUrl}" alt="Avatar" class="rounded-circle ms-2" style="width: 40px; height: 40px; object-fit: cover;">` : ''}
                </div>
            `;

            document.getElementById("chat-container").innerHTML += messageHtml;
            document.getElementById("chat-container").scrollTop = document.getElementById("chat-container").scrollHeight;
        });

        // 2. Iniciar Conexão
        connection.start().then(function () {
            console.log("SignalR Connected.");
            // Entrar no grupo da campanha
            connection.invoke("JoinCampanha", campanhaId).catch(function (err) {
                return console.error(err.toString());
            });

            document.getElementById("sendButton").disabled = false;
        }).catch(function (err) {
            return console.error(err.toString());
        });

        // 3. Enviar Mensagem
        document.getElementById("sendButton").addEventListener("click", function (event) {
            const message = document.getElementById("messageInput").value;
            if (message) {
                connection.invoke("SendMessage", campanhaId, userId, message, tipoUsuario).catch(function (err) {
                    return console.error(err.toString());
                });
                document.getElementById("messageInput").value = "";
            }
            event.preventDefault();
        });

        // Enviar mensagem ao pressionar Enter
        document.getElementById("messageInput").addEventListener("keypress", function (event) {
            if (event.key === "Enter") {
                document.getElementById("sendButton").click();
            }
        });

        // Scroll para o final ao carregar
        document.addEventListener("DOMContentLoaded", function() {
            const chatContainer = document.getElementById("chat-container");
            chatContainer.scrollTop = chatContainer.scrollHeight;
        });

    </script>
}
