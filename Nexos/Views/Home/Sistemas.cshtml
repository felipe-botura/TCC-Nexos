@model IEnumerable<Nexos.Models.Sistema>
@{
    ViewData["Title"] = "Sistemas de RPG - Nexos";
}

@section Styles {
    <style>
        .sistemas-container {
            background-color: #2D0A31;
            min-height: 100vh;
            padding: 80px 0 60px;
        }

        .sistemas-header {
            text-align: center;
            color: white;
            margin-bottom: 60px;
        }

        .sistemas-header h1 {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 20px;
        }

        .sistemas-header p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto;
        }

        .search-section {
            max-width: 800px;
            margin: 0 auto 50px;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 18px 60px 18px 25px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            color: white;
            font-size: 16px;
            transition: all 0.3s ease;
        }

        .search-box input:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: #a855f7;
            outline: none;
        }

        .search-box input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .search-box button {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border: none;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .search-box button:hover {
            transform: translateY(-50%) scale(1.05);
            box-shadow: 0 5px 15px rgba(168, 85, 247, 0.4);
        }

        .sistemas-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px;
            padding: 0 20px;
        }

        .sistema-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px 30px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .sistema-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #a855f7, #ec4899);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .sistema-card:hover {
            transform: translateY(-10px);
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(168, 85, 247, 0.5);
            box-shadow: 0 20px 40px rgba(168, 85, 247, 0.3);
        }

        .sistema-card:hover::before {
            transform: scaleX(1);
        }

        .sistema-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 25px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: white;
            transition: all 0.3s ease;
        }

        .sistema-card:hover .sistema-icon {
            transform: rotateY(360deg) scale(1.1);
        }

        .sistema-name {
            font-weight: 700;
            color: white;
            margin-bottom: 15px;
        }

        .sistema-description {
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .sistema-stats {
            display: flex;
            justify-content: space-around;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            display: block;
            font-weight: 700;
            color: #a855f7;
            margin-bottom: 5px;
        }

        .stat-label {
            color: rgba(255, 255, 255, 0.6);
        }

        .no-results {
            text-align: center;
            padding: 80px 20px;
            color: rgba(255, 255, 255, 0.6);
        }

        .no-results i {
            font-size: 4rem;
            opacity: 0.3;
            margin-bottom: 20px;
        }

        .no-results h3 {
            color: white;
            margin-bottom: 10px;
        }

        .filter-section {
            text-align: center;
            margin-bottom: 40px;
        }

        .filter-buttons {
            display: inline-flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .filter-btn {
            padding: 12px 28px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(168, 85, 247, 0.4);
        }

        (max-width: 768px) {
            .sistemas-header h1 {
                font-size: 2rem;
            }

            .sistemas-grid {
                grid-template-columns: 1fr;
            }

            .filter-buttons {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-btn {
                width: 100%;
            }
        }
    </style>
}

<div class="sistemas-container">
    <div class="container">
        <!-- Header -->
        <div class="sistemas-header">
            <h1><i class="fas fa-dice-d20"></i> Descubra os mais diversos sistemas</h1>
            <p>Explore uma vasta biblioteca de sistemas de RPG, desde os clássicos até os mais modernos</p>
        </div>

        <!-- Search Section -->
        <div class="search-section">
            <form class="search-box" id="searchForm">
                <input type="text" id="searchInput" placeholder="Pesquisar sistemas de RPG..."
                    aria-label="Pesquisar sistemas">
                <button type="submit" aria-label="Buscar">
                    <i class="fas fa-search"></i>
                </button>
            </form>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="filter-buttons">
                <button class="filter-btn active" data-filter="all">
                    <i class="fas fa-globe"></i> Todos
                </button>
                <button class="filter-btn" data-filter="indie">
                    <i class="fas fa-heart"></i> Indie
                </button>
                <button class="filter-btn" data-filter="classico">
                    <i class="fas fa-crown"></i> Clássicos
                </button>
                <button class="filter-btn" data-filter="moderno">
                    <i class="fas fa-star"></i> Modernos
                </button>
            </div>
        </div>

        <!-- Sistemas Grid -->
        <div class="sistemas-grid" id="sistemasGrid">
            @if (Model != null && Model.Any())
            {
                @foreach (var sistema in Model)
                {
                    <article class="sistema-card" data-sistema="@sistema.Nome_Sistema.ToLower()">
                        <div class="sistema-icon">
                            <i class="fas fa-dice-d20"></i>
                        </div>
                        <h3 class="sistema-name">@sistema.Nome_Sistema</h3>
                        <p class="sistema-description">
                            Sistema de RPG completo com regras detalhadas para criar aventuras épicas e memoráveis.
                        </p>
                        <div class="sistema-stats">
                            <div class="stat-item">
                                <span class="stat-number">@(new Random().Next(5, 50))</span>
                                <span class="stat-label">Mesas</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">@(new Random().Next(10, 200))</span>
                                <span class="stat-label">Jogadores</span>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="no-results" style="grid-column: 1 / -1;">
                    <i class="fas fa-inbox"></i>
                    <h3>Nenhum sistema cadastrado</h3>
                    <p>Ainda não há sistemas de RPG disponíveis no momento.</p>
                </div>
            }
        </div>

        <!-- No Results Message (Hidden by default) -->
        <div class="no-results" id="noResults" style="display: none; grid-column: 1 / -1;">
            <i class="fas fa-search"></i>
            <h3>Nenhum sistema encontrado</h3>
            <p>Tente ajustar sua pesquisa ou filtros.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add action to HomeController.cs:
        // public IActionResult Sistemas()
        // {
        //     var sistemas = _context.Sistemas.ToList();
        //     return View(sistemas);
        // }

        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const searchForm = document.getElementById('searchForm');
            const sistemasGrid = document.getElementById('sistemasGrid');
            const noResults = document.getElementById('noResults');
            const filterButtons = document.querySelectorAll('.filter-btn');
            const cards = document.querySelectorAll('.sistema-card');

            // Search functionality
            function performSearch(searchTerm) {
                const term = searchTerm.toLowerCase().trim();
                let visibleCount = 0;

                cards.forEach(card => {
                    const sistemaNome = card.dataset.sistema;
                    if (sistemaNome.includes(term)) {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Show/hide no results message
                if (visibleCount === 0) {
                    sistemasGrid.style.display = 'none';
                    noResults.style.display = 'block';
                } else {
                    sistemasGrid.style.display = 'grid';
                    noResults.style.display = 'none';
                }
            }

            // Search form submit
            searchForm.addEventListener('submit', function (e) {
                e.preventDefault();
                performSearch(searchInput.value);
            });

            // Real-time search
            searchInput.addEventListener('input', function () {
                performSearch(this.value);
            });

            // Filter buttons (placeholder functionality)
            filterButtons.forEach(button => {
                button.addEventListener('click', function () {
                    // Remove active class from all buttons
                    filterButtons.forEach(btn => btn.classList.remove('active'));

                    // Add active class to clicked button
                    this.classList.add('active');

                    const filter = this.dataset.filter;

                    // Show all cards when "Todos" is selected
                    if (filter === 'all') {
                        cards.forEach(card => card.style.display = 'block');
                        sistemasGrid.style.display = 'grid';
                        noResults.style.display = 'none';
                    } else {
                        // For other filters, you can implement specific logic
                        // For now, just show all cards
                        cards.forEach(card => card.style.display = 'block');
                    }
                });
            });

            // Click on card to navigate
            cards.forEach(card => {
                card.addEventListener('click', function () {
                    const sistemaNome = this.querySelector('.sistema-name').textContent;

                    // Navigate to Mesas page with sistema filter
                    window.location.href = '@Url.Action("Mesas", "Home")';
                });
            });
        });
    </script>
}