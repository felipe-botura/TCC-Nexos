@model Nexos.Models.CampanhaMesa

@{
    ViewData["Title"] = "Criar Mesa";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

@section Styles {
    <style>
    .create-campaign-container {
        background: linear-gradient(135deg, #1a0b2e 0%, #2d1b4e 100%);
        min-height: 100vh;
        padding: 80px 0 60px;
    }

    .create-header {
        text-align: center;
        color: white;
        margin-bottom: 50px;
    }

    .create-header h1 {
        font-weight: 700;
        background: linear-gradient(135deg, #a855f7, #ec4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 15px;
    }

    .create-header p {
        color: rgba(255, 255, 255, 0.7);
    }

    .form-container {
        max-width: 1200px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        padding: 40px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .section-title {
        color: white;
        font-weight: 600;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid rgba(168, 85, 247, 0.3);
    }

    .form-label {
        color: white;
        font-weight: 600;
        margin-bottom: 10px;
        display: block;
    }

    .form-control,
    .form-select {
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        color: white;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

    .form-control:focus,
    .form-select:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: #a855f7;
        box-shadow: 0 0 0 0.2rem rgba(168, 85, 247, 0.25);
        color: white;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .form-select option {
        background: #2d1b4e;
        color: white;
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .button-group {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 40px;
    }

    .btn-submit {
        background: linear-gradient(135deg, #a855f7, #ec4899);
        border: none;
        color: white;
        padding: 15px 50px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(168, 85, 247, 0.4);
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(168, 85, 247, 0.6);
    }

    .btn-cancel {
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: white;
        padding: 15px 50px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.5);
        color: white;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .tag-button {
        background: rgba(168, 85, 247, 0.2);
        border: 2px solid rgba(168, 85, 247, 0.5);
        color: white;
        padding: 8px 20px;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .tag-button:hover,
    .tag-button.active {
        background: rgba(168, 85, 247, 0.4);
        border-color: #a855f7;
        transform: translateY(-2px);
    }

    .vagas-control {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .vagas-button {
        background: rgba(168, 85, 247, 0.3);
        border: none;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .vagas-button:hover {
        background: rgba(168, 85, 247, 0.5);
        transform: scale(1.1);
    }

    .vagas-display {
        font-size: 2rem;
        font-weight: 700;
        color: white;
        min-width: 60px;
        text-align: center;
    }

    .text-danger {
        color: #ff6b9d !important;
        margin-top: 5px;
    }

    .alert-danger {
        background: rgba(255, 107, 157, 0.2);
        border: 1px solid rgba(255, 107, 157, 0.5);
        color: #ff6b9d;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 30px;
    }

    .form-container {
        padding: 25px;
    }

    .button-group {
        flex-direction: column;
    }

    .btn-submit,
    .btn-cancel {
        width: 100%;
    }

    .form-control {
        height: calc(3.25rem + 2px);
        font-size: 1.5rem;
    }

    .nice-select .option {
        background-color: #2a003f !important;
    }

    .nice-select .list:hover {
        background-color: #2a003f !important;
    }

    .form-select {
        display: flex;
        align-items: center;
    }

    .form-control {
        display: flex;
        align-items: center;
        height: fit-content;
    }

}
</style>
}

<div class="create-campaign-container">
    <div class="container">
        <div class="create-header">
            <h1><i class="fas fa-dice-d20"></i> Crie a sua Mesa</h1>
            <p>Junte um grupo, e comece a mestrar sua campanha!</p>
        </div>

        <div class="form-container">
            <form asp-action="Create" asp-controller="CampanhasMesas" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Imagem de Capa -->
                <h3 class="section-title mt-5">Imagem de Capa</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Selecione uma imagem de capa para a sua campanha.
                </p>
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label for="ImagemUpload" class="form-label">Arquivo de Imagem</label>
                        <input type="file" name="ImagemUpload" id="ImagemUpload" class="form-control"
                            accept="image/*" />
                        <span class="text-danger"></span>
                    </div>
                </div>

                <!-- Detalhes da Campanha -->
                <h3 class="section-title">Detalhes da Campanha</h3>
                <p style="color: rgba(255, 255, 255, 0.7); margin-bottom: 30px;">
                    Os detalhes da campanha são importantes, tente não se esquecer de nada
                </p>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <label asp-for="Titulo_Campanha" class="form-label">Título</label>
                        <input asp-for="Titulo_Campanha" class="form-control" placeholder="Título da aventura" />
                        <span asp-validation-for="Titulo_Campanha" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Dias e Horários</label>
                        <input asp-for="Dias_Horarios" class="form-control"
                            placeholder="Duas e horários em que as sessões vão acontecer" />
                        <span asp-validation-for="Dias_Horarios" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ID_Sistema" class="form-label">Sistema</label>
                        <select asp-for="ID_Sistema" class="form-select" asp-items="ViewBag.ID_Sistema">
                            <option value="">Selecione o sistema que você usará</option>
                        </select>
                        <span asp-validation-for="ID_Sistema" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="ID_Genero" class="form-label">Gênero</label>
                        <select asp-for="ID_Genero" class="form-select" asp-items="ViewBag.ID_Genero">
                            <option value="">Selecione o gênero da sua campanha</option>
                        </select>
                        <span asp-validation-for="ID_Genero" class="text-danger"></span>
                    </div>
                </div>

                <!-- Status e Modalidade -->
                <h3 class="section-title mt-5">Status</h3>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Selecione o status atual da campanha</label>
                        <div class="tags-container">
                            <input type="radio" name="Status_Campanha" value="Ativa" id="statusAtiva"
                                style="display: none;" />
                            <label for="statusAtiva" class="tag-button"
                                onclick="this.previousElementSibling.checked = true">
                                Ativa
                            </label>

                            <input type="radio" name="Status_Campanha" value="Em breve" id="statusBreve"
                                style="display: none;" />
                            <label for="statusBreve" class="tag-button"
                                onclick="this.previousElementSibling.checked = true">
                                Em breve
                            </label>
                        </div>
                        <span asp-validation-for="Status_Campanha" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Selecione a modalidade da campanha</label>
                        <div class="tags-container">
                            <input type="radio" name="Modalidade" value="Online" id="modalidadeOnline"
                                style="display: none;" />
                            <label for="modalidadeOnline" class="tag-button"
                                onclick="this.previousElementSibling.checked = true">
                                Online
                            </label>

                            <input type="radio" name="Modalidade" value="Presencial" id="modalidadePresencial"
                                style="display: none;" />
                            <label for="modalidadePresencial" class="tag-button"
                                onclick="this.previousElementSibling.checked = true">
                                Presencial
                            </label>
                        </div>
                        <span asp-validation-for="Modalidade" class="text-danger"></span>
                    </div>
                </div>

                <!-- Vagas e Faixa Etária -->
                <h3 class="section-title mt-5">Vagas e Faixa Etária</h3>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Número de Vagas</label>
                        <div class="vagas-control">
                            <button type="button" class="vagas-button" onclick="decrementVagas()">
                                <i class="fas fa-minus"></i>
                            </button>
                            <span id="vagasDisplay" class="vagas-display">5</span>
                            <input type="hidden" asp-for="Vagas_Disponiveis" id="vagasInput" value="5" />
                            <input type="hidden" asp-for="Numero_Jogadores" id="jogadoresInput" value="5" />
                            <button type="button" class="vagas-button" onclick="incrementVagas()">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Vagas_Disponiveis" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Faixa_Etaria" class="form-label">Faixa Etária</label>
                        <select asp-for="Faixa_Etaria" class="form-select">
                            <option value="">Selecione a faixa etária</option>
                            <option value="Livre">Livre</option>
                            <option value="10+">10+</option>
                            <option value="12+">12+</option>
                            <option value="14+">14+</option>
                            <option value="16+">16+</option>
                            <option value="18+">18+</option>
                        </select>
                        <span asp-validation-for="Faixa_Etaria" class="text-danger"></span>
                    </div>
                </div>

                <!-- Premissa e Expectativas -->
                <h3 class="section-title mt-5">Premissa e Expectativas</h3>
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label asp-for="Premissa_Campanha" class="form-label">Premissa da Campanha</label>
                        <textarea asp-for="Premissa_Campanha" class="form-control"
                            placeholder="Descreva a premissa da sua aventura..."></textarea>
                        <span asp-validation-for="Premissa_Campanha" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <label asp-for="O_Que_Esperar" class="form-label">O que esperar dos jogadores?</label>
                        <textarea asp-for="O_Que_Esperar" class="form-control"
                            placeholder="Detalhe o que você espera dos jogadores..."></textarea>
                        <span asp-validation-for="O_Que_Esperar" class="text-danger"></span>
                    </div>
                </div>

                <!-- Requisitos e Plataformas -->
                <h3 class="section-title mt-5">Requisitos e Plataformas</h3>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Requisitos" class="form-label">Requisitos para Jogar</label>
                        <textarea asp-for="Requisitos" class="form-control"
                            placeholder="Ex: Livros, dados, microfone..."></textarea>
                        <span asp-validation-for="Requisitos" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Plataformas" class="form-label">Plataformas Utilizadas</label>
                        <textarea asp-for="Plataformas" class="form-control"
                            placeholder="Ex: Discord, Roll20, Foundry VTT..."></textarea>
                        <span asp-validation-for="Plataformas" class="text-danger"></span>
                    </div>
                </div>

                <div class="button-group">
                    <button type="submit" class="btn btn-submit">
                        <i class="fas fa-plus-circle"></i> Criar Mesa
                    </button>
                    <a asp-action="Index" class="btn btn-cancel">
                        <i class="fas fa-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function updateVagasDisplay() {
            const vagasInput = document.getElementById('vagasInput');
            const jogadoresInput = document.getElementById('jogadoresInput');
            const vagasDisplay = document.getElementById('vagasDisplay');
            vagasDisplay.textContent = vagasInput.value;
            jogadoresInput.value = vagasInput.value; // Manter os dois campos sincronizados
        }

        function incrementVagas() {
            const vagasInput = document.getElementById('vagasInput');
            let currentValue = parseInt(vagasInput.value);
            if (currentValue < 10) {
                vagasInput.value = currentValue + 1;
                updateVagasDisplay();
            }
        }

        function decrementVagas() {
            const vagasInput = document.getElementById('vagasInput');
            let currentValue = parseInt(vagasInput.value);
            if (currentValue > 1) {
                vagasInput.value = currentValue - 1;
                updateVagasDisplay();
            }
        }

        // Inicializa o display ao carregar a página
        document.addEventListener('DOMContentLoaded', updateVagasDisplay);
    </script>
}
