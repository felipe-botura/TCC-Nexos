@model Nexos.Models.CampanhaMesa
@{
    ViewData["Title"] = @Model.Titulo_Campanha;
}

@section Styles {
    <link rel="stylesheet" href="~/css/mesa-detalhes.css">
}

<!-- Hero Section -->
<section class="hero-section-mesa" style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('@Model.Imagem_Capa'); background-size: cover;">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-3 fw-bold mb-3">@Model.Titulo_Campanha</h1>
                <p class="lead">Junte-se a uma jornada emocionante criada pelo nosso Mestre de Jogo experiente!</p>
            </div>
        </div>
    </div>
</section>

<!-- Game Master Section -->
<section class="gm-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-2">
                <div class="gm-avatar">
                    <img src="@(Model.Mestre.Foto ?? Url.Content("~/img/usuarios/no-photo.png"))" 
                         width="80" 
                         height="80"
                         class="object-fit-cover rounded-circle"
                         alt="Foto do Mestre @Model.Mestre.Nome">
                </div>
            </div>
            <div class="col-md-8">
                <h4 class="fw-bold mb-2">Game Master: @Model.Mestre.Nome</h4>
            </div>
            <div class="col-md-2">
               <a asp-controller="Chat" asp-action="Campanha" asp-route-id="@Model.ID_Campanha" class="btn btn-success btn-lg px-5 py-3 rounded-pill">
	                    Acessar Chat
	                </a>
            </div>
        </div>
    </div>
</section>

<!-- Premissa da Campanha -->
<section class="premissa-section section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold">Premissa da Campanha</h2>
            </div>
        </div>
        
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <div class="premissa-image">
                    <img src="@Model.Imagem_Capa" alt="Premissa da Campanha" class="img-fluid rounded shadow-lg" style="width: 100%; height: auto; object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="premissa-content ps-lg-4">
                    <p class="lead mb-0">
                       @Model.Premissa_Campanha
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- O que Esperar Section -->
<section class="expectativas-section section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold">O Que Esperar</h2>
            </div>
        </div>
        
        <div class="expectativas-description mb-5">
            <p class="text-center lead mb-5">
                @Model.O_Que_Esperar
            </p>
        </div>

        <!-- Cards de Informações -->
        <div class="row g-5 mt-4">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Faixa Etária</h5>
                    <p class="mb-2">@Model.Faixa_Etaria</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Sistema</h5>
                    <p class="mb-2">@Model.Sistema.Nome_Sistema</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Gênero</h5>
                    <p class="mb-2">@Model.Genero.Nome_Genero</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Vagas Disponíveis</h5>
                    <p class="mb-2">@Model.Vagas_Disponiveis</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Dias e Horários</h5>
                    <p class="mb-2">@Model.Dias_Horarios</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Modalidade</h5>
                    <p class="mb-2">@Model.Modalidade</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Plataformas</h5>
                    <p class="mb-2">@Model.Plataformas</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Requisitos</h5>
                    <p class="mb-2">@Model.Requisitos</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
<a asp-controller="Chat" asp-action="Campanha" asp-route-id="@Model.ID_Campanha" class="btn btn-success btn-lg px-5 py-3 rounded-pill">
	                    Acessar Chat
	                </a>
            </div>
        </div>
    </div>
</section>