@model Nexos.Models.CampanhaMesa
@{
    ViewData["Title"] = @Model.Titulo_Campanha;
}

@section Styles {
    <link rel="stylesheet" href="~/css/mesa-detalhes.css">
}

<!-- Hero Section -->
<section class="hero-section-mesa">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-3 fw-bold mb-3">@Model.Titulo_Campanha</h1>
                <p class="lead">Join a thrilling journey crafted by our experienced Game Master!</p>
            </div>
        </div>
    </div>
</section>

<!-- Game Master Section -->
<section class="gm-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-2">
                <div class="gm-avatar">
                    <div class="avatar-placeholder rounded-circle"></div>
                </div>
            </div>
            <div class="col-md-8">
                <h4 class="fw-bold mb-2">Game Master: JohnDoe</h4>
                <p class="mb-0">Step into a realm filled with adventure and peril as we explore the mystical forests of Eldaria.</p>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-light">Contact GM</button>
            </div>
        </div>
    </div>
</section>

<!-- Premissa da Campanha -->
<section class="premissa-section section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold">Premissa da Campanha</h2>
            </div>
        </div>
        
        <div class="row align-items-center">
            <div class="col-lg-5">
                <div class="premissa-image">
                    <div class="image-placeholder">
                        <span>Imagem relacionada</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="premissa-content">
                    <p class="mb-4">
                       @Model.Premissa_Campanha
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- O que Esperar Section -->
<section class="expectativas-section section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold">O Que Esperar</h2>
            </div>
        </div>
        
        <div class="expectativas-description mb-5">
            <p class="text-center lead">
                @Model.O_Que_Esperar
            </p>
        </div>

        <!-- Cards de Informações -->
        <div class="row g-4">
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Faixa Etária</h5>
                    <p class="mb-2">@Model.Faixa_Etaria</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Sistema</h5>
                    <p class="mb-2">@Model.ID_Sistema</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Gênero</h5>
                    <p class="mb-2">@Model.ID_Genero</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Vagas Disponíveis</h5>
                    <p class="mb-2">@Model.Vagas_Disponiveis</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Dias e Horários</h5>
                    <p class="mb-2">@Model.Dias_Horarios</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;" style="margin: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Modalidade</h5>
                    <p class="mb-2">@Model.Modalidade</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Plataformas</h5>
                    <p class="mb-2">@Model.Plataformas</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6" style="margin-Bottom: 10px;">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Requisitos</h5>
                    <p class="mb-2">@Model.Requisitos</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <button class="btn btn-primary btn-lg px-5 py-3 rounded-pill">
                    Mandar Solicitação
                </button>
            </div>
        </div>
    </div>
</section>

