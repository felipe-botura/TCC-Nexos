@model List<CampanhaMesa>
@{
  ViewData["Title"] = "Mesas Disponíveis";
}

@section Styles {
    <link rel="stylesheet" href="~/css/mesas.css">
}

<main role="main">
  <section class="main-header1" aria-labelledby="main-title" style="margin-top: 150px;">
    <h1 id="main-title">Descubra campanhas e Mesas disponíveis</h1>
    <p>Encontre uma campanha sem igual para jogar RPG. Explore campanhas, mesas e one-shots aqui mesmo!</p>
    <button class="border-btn" type="button" aria-label="Criar nova campanha">Criar Campanha</button>
  </section>

  <section class="filters" aria-label="Filtros para pesquisa de campanhas">
    <div class="filter-box" tabindex="0" aria-label="Filtro de gêneros">
      <strong class="dropdown-toggle">Gênero</strong>
      <span>Fantasia, Horror, sci-fi mistério,</span>
    </div>
    <div class="filter-box" tabindex="0" aria-label="Filtro de sistemas de jogo">
      <strong class="dropdown-toggle">Sistema</strong>
      <span>Dungeons & Dragons, Pathfinder, etc.</span>
    </div>
    <div class="filter-box" tabindex="0" aria-label="Filtro de modalidade">
      <strong class="dropdown-toggle">Modalidade</strong>
      <span>Escolha entre presencial ou online</span>
    </div>
    <div class="filter-box" tabindex="0" aria-label="Filtro de categoria">
      <strong class="dropdown-toggle">Categoria</strong>
      <span>One-shot, campanha longa, etc...</span>
    </div>
  </section>

  <section class="campaigns-grid" aria-label="Campanhas disponíveis para jogar">

    @foreach (var campanhaMesa in Model)
{
    <!-- Card 1 -->
    <article class="card" tabindex="0"
        aria-label="@campanhaMesa.Titulo_Campanha. Gênero Fantasia. Mestre Hemi Domiciano. Jogadores @campanhaMesa.Numero_Jogadores">
        <div class="card-image">
        <img
            src="@campanhaMesa.Imagem_Capa"
            alt="Capa da campanha de RPG fantasy, cores roxas e detalhes de fantasia"
            onerror="this.style.backgroundColor='#513b71';" />
        <span class="tag">Fantasia</span>
        </div>
        <div class="card-content">
        <strong>@campanhaMesa.Titulo_Campanha</strong>
        <small>Mestre: Hemi Domiciano - @campanhaMesa.Numero_Jogadores</small>
        </div>
    </article>
}
  </section>
  <button class="border-btn" aria-label="Carregar mais mesas" disabled>Mais mesas</button>

</main>
