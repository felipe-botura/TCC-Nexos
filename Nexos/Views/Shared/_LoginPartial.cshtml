@using Microsoft.AspNetCore.Identity
@inject Nexos.Data.AppDbContext _db
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

@{
    Usuario usuario = null;
    string fotoUrl = Url.Content("~/img/usuarios/no-photo.png");
    
    if (SignInManager.IsSignedIn(User))
    {
        var userName = UserManager.GetUserName(User);
        if (!string.IsNullOrEmpty(userName))
        {
            usuario = _db.Usuarios.FirstOrDefault(u => u.UserName == userName);
            if (usuario != null && !string.IsNullOrEmpty(usuario.Foto))
            {
                fotoUrl = usuario.Foto;
            }
        }
    }
}

@if (!SignInManager.IsSignedIn(User))
{
    <li class="button-header margin-left"><a href="@Url.Action("Register","Account")" class="btn">Criar Conta</a></li>
    <li class="button-header"><a href="@Url.Action("Login","Account")" class="btn3">Entrar</a></li>
}
else
{
    <div class="nav-item dropdown me-2">
        <div class="nav-link bg-transparent border-0 text-white dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="@fotoUrl" width="40" height="40"
                class="object-fit-cover rounded-5" alt="Foto do usuário">
        </div>
        <ul class="dropdown-menu" style="position:absolute!important; margin-left: -200px!important; width:310px">
            @if (User.IsInRole("Administrador") || User.IsInRole("Funcionário"))
            {
                <li>
                    <a class="dropdown-item" asp-action="Index" asp-controller="Home">
                        <i class="bi bi-house"></i> Acessar Área Pública
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-action="Index" asp-controller="Admin">
                        <i class="bi bi-receipt"></i> Acessar Área Administrativa
                    </a>
                </li>
            }
            <li>
                <a class="dropdown-item" asp-action="Perfil" asp-controller="Account">
                    <i class="bi bi-person-bounding-box"></i> Gerenciar Conta
                </a>
            </li>
            <li>
                <form method="POST" asp-action="Logout" asp-controller="Account">
                    <button type="submit" class="dropdown-item aling-middle">
                        <i class="bi bi-door-closed"></i> Sair
                    </button>
                </form>
            </li>
        </ul>
    </div>
}