@model Nexos.Models.Genero

@{
    ViewData["Title"] = "Criar Gênero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container pt-50 pb-50">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h1 class="section-title mb-40">Criar Novo Gênero</h1>
            <div class="card bg-dark text-white p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group mb-3">
                        <label asp-for="Nome_Genero" class="control-label"></label>
                        <input asp-for="Nome_Genero" class="form-control bg-secondary text-white border-0" />
                        <span asp-validation-for="Nome_Genero" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Criar" class="btn hero-btn" />
                        <a asp-action="Index" class="btn btn-secondary ml-2">Voltar para a Lista</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

