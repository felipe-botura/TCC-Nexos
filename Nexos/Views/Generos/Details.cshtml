@model Nexos.Models.Genero

@{
    ViewData["Title"] = "Detalhes do Gênero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container pt-50 pb-50">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h1 class="section-title mb-40">Detalhes do Gênero</h1>
            <div class="card bg-dark text-white p-4">
                <dl class="row mb-4">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Nome_Genero)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Nome_Genero)
                    </dd>
                </dl>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.ID_Genero" class="btn hero-btn">Editar</a>
                    <a asp-action="Index" class="btn btn-secondary ml-2">Voltar para a Lista</a>
                </div>
            </div>
        </div>
    </div>
</div>

